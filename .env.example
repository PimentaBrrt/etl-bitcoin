# =====================================================================
# Copie este arquivo para `.env` e preencha os valores reais.
# O arquivo .env NAO deve ser commitado (ja esta no .gitignore).
# =====================================================================

# --- Fonte 1: Mercado (API REST Binance) ---
# A fonte de mercado e a Binance (klines diarios), publica e SEM chave.
# Trocamos a CoinGecko pela Binance porque o plano gratuito da CoinGecko so
# entrega os ultimos 365 dias, sem intersecao com o CSV de Fear & Greed
# (2018-2023). A janela abaixo casa com o periodo do CSV.
MARKET_BASE_URL=https://api.binance.com
MARKET_SYMBOL=BTCUSDT
MARKET_START_DATE=2018-02-01
MARKET_END_DATE=2023-03-31
# Supply circulante aproximado do BTC (usado para estimar o market cap):
MARKET_CIRCULATING_SUPPLY=19800000

# --- PostgreSQL (Data Warehouse) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=btc_dw
POSTGRES_USER=btc
POSTGRES_PASSWORD=btc

# --- (LEGADO) CoinGecko ---
# Mantido apenas por compatibilidade historica; NAO e mais usado pelo pipeline.
# Pode ser removido com seguranca.
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3/
# COINGECKO_COIN_ID=bitcoin
# COINGECKO_VS_CURRENCY=usd
# COINGECKO_DAYS=365
